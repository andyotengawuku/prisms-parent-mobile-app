# Base URL of the PRIS web deployment's API (the prisms-system Next.js app).
# Local development against the web repo:
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
# Set this to the EAS project UUID in environments that build push-enabled apps.
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Production example:
# EXPO_PUBLIC_API_BASE_URL=https://your-pris-deployment.netlify.app/api
